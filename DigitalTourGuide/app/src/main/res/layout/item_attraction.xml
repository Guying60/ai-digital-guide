<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardPreventCornerOverlap="false"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <!-- 多选复选框 -->
        <CheckBox
            android:id="@+id/checkbox_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:visibility="gone" />

        <!-- 封面图片 -->
        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="96dp"
            android:layout_height="80dp"
            android:layout_toEndOf="@id/checkbox_select"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_pdf"
            android:background="@drawable/bg_search_rounded" />

        <!-- 景点名称 -->
        <TextView
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iv_cover"
            android:paddingTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 评分行 -->
        <LinearLayout
            android:id="@+id/layout_rating_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_name"
            android:layout_toEndOf="@id/iv_cover"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_star_filled"
                app:tint="#FFC107" />

            <TextView
                android:id="@+id/tv_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#333333"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_review_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#999999"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 开放时间 -->
        <TextView
            android:id="@+id/tv_open_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/layout_rating_info"
            android:layout_toEndOf="@id/iv_cover"
            android:layout_marginTop="4dp"
            android:textColor="#999999"
            android:textSize="12sp" />

        <!-- 编辑/删除按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_open_hours"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tv_edit"
                android:layout_width="60dp"
                android:layout_height="35dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:text="编辑"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:backgroundTint="#7854F4" />

            <Button
                android:id="@+id/tv_delete"
                android:layout_width="60dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:text="删除"
                android:textColor="#FF4D4F"
                android:textSize="13sp"
                android:backgroundTint="@color/profile_error_container"
                />
        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>
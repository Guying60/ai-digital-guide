<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    android:fitsSystemWindows="true">

    <!-- 滚动内容区域（在保存按钮上方） -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btn_save"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ======================== 分段标题栏 ======================== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_segment_container"
                android:orientation="horizontal"
                android:padding="3dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/tab_scenic"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="28dp"
                    android:background="@drawable/bg_segment_active"
                    android:text="@string/se_edit_attraction"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_digital_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="28dp"
                    android:background="@drawable/bg_segment_inactive"
                    android:text="@string/se_edit_digital"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ======================== 封面方框 ======================== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:contentPadding="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/se_change_cover"
                        android:background="#F3F4F6" />

                    <!-- 图片占位提示（无图片时显示） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_add"
                            android:alpha="0.3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/se_change_cover"
                            android:textColor="#CCCCCC"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- 更换封面按钮 -->
                    <TextView
                        android:id="@+id/tv_edit_cover"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_search"
                        android:elevation="2dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="@string/se_change_cover"
                        android:textColor="#333333"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <!-- ======================== 内容区域 ======================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <!-- ===== 景点名称 ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/se_attraction_name"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/et_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_card_bg"
                    android:gravity="start"
                    android:hint="@string/se_name_hint"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp"
                    android:textColor="#111111"
                    android:textColorHint="#999999"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- 间距 -->
                <View android:layout_width="match_parent" android:layout_height="24dp" />

                <!-- ===== 景点类型 ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/se_attraction_type"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/input_card_bg"
                    android:foreground="?attr/selectableItemBackground">

                    <Spinner
                        android:id="@+id/spinner_type"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="start|center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="52dp"
                        android:textColor="#111111"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chevron_down"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <!-- 间距 -->
                <View android:layout_width="match_parent" android:layout_height="32dp" />

                <!-- ===== 知识库 ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 标题行 -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_alignParentStart="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/se_knowledge_base"
                                android:textColor="#666666"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_chip_selected"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="@string/se_max_files"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 添加按钮 -->
                        <LinearLayout
                            android:id="@+id/ll_upload"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_add"
                                android:contentDescription="@string/se_add_file" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/se_add_file"
                                android:textColor="#4F46E5"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- 文件卡片 - 水平滚动 -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="start"
                            android:paddingEnd="4dp">

                            <!-- ===== 文件槽位 1 ===== -->
                            <LinearLayout
                                android:layout_width="200dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/bg_file_card"
                                android:padding="16dp"
                                android:layout_marginEnd="12dp">

                                <!-- 图标 -->
                                <FrameLayout
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"

                                    android:layout_marginBottom="12dp">

                                    <ImageView
                                        android:id="@+id/iv_file_icon_1"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="@string/se_remove"
                                        android:scaleType="center"
                                        android:visibility="gone" />
                                </FrameLayout>

                                <!-- 文件名 -->
                                <TextView
                                    android:id="@+id/file_name_1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/se_no_file"
                                    android:textColor="#111111"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                                <!-- 移除按钮 -->
                                <TextView
                                    android:id="@+id/tv_delete_1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/se_remove"
                                    android:textColor="#EF4444"
                                    android:textSize="12sp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="4dp"
                                    android:background="@drawable/bg_btn_danger_outline"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <!-- ===== 文件槽位 2 ===== -->
                            <LinearLayout
                                android:layout_width="200dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/bg_file_card"
                                android:padding="16dp"
                                android:layout_marginEnd="12dp">

                                <FrameLayout
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"

                                    android:layout_marginBottom="12dp">

                                    <ImageView
                                        android:id="@+id/iv_file_icon_2"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="@string/se_remove"
                                        android:scaleType="center"
                                        android:visibility="gone" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/file_name_2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/se_no_file"
                                    android:textColor="#111111"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                                <TextView
                                    android:id="@+id/tv_delete_2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/se_remove"
                                    android:textColor="#EF4444"
                                    android:textSize="12sp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="4dp"
                                    android:background="@drawable/bg_btn_danger_outline"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <!-- ===== 文件槽位 3 ===== -->
                            <LinearLayout
                                android:layout_width="200dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/bg_file_card"
                                android:padding="16dp"
                                android:layout_marginEnd="12dp">

                                <FrameLayout
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"

                                    android:layout_marginBottom="12dp">

                                    <ImageView
                                        android:id="@+id/iv_file_icon_3"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="@string/se_remove"
                                        android:scaleType="center"
                                        android:visibility="gone" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/file_name_3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/se_no_file"
                                    android:textColor="#111111"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                                <TextView
                                    android:id="@+id/tv_delete_3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/se_remove"
                                    android:textColor="#EF4444"
                                    android:textSize="12sp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="4dp"
                                    android:background="@drawable/bg_btn_danger_outline"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <!-- ===== 文件槽位 4 ===== -->
                            <LinearLayout
                                android:layout_width="200dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="@drawable/bg_file_card"
                                android:padding="16dp"
                                android:layout_marginEnd="4dp">

                                <FrameLayout
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"

                                    android:layout_marginBottom="12dp">

                                    <ImageView
                                        android:id="@+id/iv_file_icon_4"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="@string/se_remove"
                                        android:scaleType="center"
                                        android:visibility="gone" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/file_name_4"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/se_no_file"
                                    android:textColor="#111111"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                                <TextView
                                    android:id="@+id/tv_delete_4"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/se_remove"
                                    android:textColor="#EF4444"
                                    android:textSize="12sp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:paddingHorizontal="12dp"
                                    android:paddingVertical="4dp"
                                    android:background="@drawable/bg_btn_danger_outline"
                                    android:visibility="gone" />
                            </LinearLayout>

                        </LinearLayout>
                    </HorizontalScrollView>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 保存按钮（固定底部） -->
    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#8B5CF6"
        android:elevation="4dp"
        android:stateListAnimator="@animator/btn_lift"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/se_save_changes"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_surface"
    android:keepScreenOn="true">

    <!-- 背景光晕（扩大淡化） -->
    <View
        android:id="@+id/bg_glow"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:background="@drawable/bg_splash_glow"
        android:alpha="0.08"
        app:layout_constraintBottom_toTopOf="@+id/character_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ========== 顶部标题 ========== -->
    <LinearLayout
        android:id="@+id/top_branding"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="数字人导游"
            android:textColor="@color/profile_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.05"
            android:text="您的 AI 智能旅游助手"
            android:textAllCaps="true"
            android:textColor="@color/profile_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ========== 角色形象 ========== -->
    <ImageView
        android:id="@+id/character_image"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:background="@drawable/ic_splash"
        android:contentDescription="数字人导游"
        app:layout_constraintBottom_toTopOf="@+id/bottom_loading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_branding" />

    <!-- ========== 底部加载区 ========== -->
    <LinearLayout
        android:id="@+id/bottom_loading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="72dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/character_image">

        <!-- 启动消息 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star_filled"
                app:tint="@color/profile_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="正在启动导游服务..."
                android:textColor="@color/profile_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 进度条 -->
        <ProgressBar
            android:id="@+id/loading_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="24dp"
            android:indeterminate="true"
            android:progressTint="@color/profile_primary"
            android:progressBackgroundTint="@color/profile_surface_container"
            android:progressBackgroundTintMode="src_over" />

        <!-- 云端验证 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_splash_badge"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <View
                android:id="@+id/status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot_pulse" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.05"
                android:text="云端验证"
                android:textColor="@color/profile_on_surface_variant"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部渐变 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_splash_bottom_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/character_image" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/input_card_bg"
    android:padding="12dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:elevation="1dp"
    android:gravity="center_vertical">

    <!-- Left: Cover Image -->
    <ImageView
        android:id="@+id/iv_cover"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:background="#F0F1F5"
        android:src="@drawable/ic_pdf"
        android:contentDescription="@string/app_name"
        />

    <!-- Right: Content Area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <!-- Row 1: Title + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textColor="#191C1F"
                android:maxLines="1"
                android:ellipsize="end"
                android:textStyle="bold"
                />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_status_pill"
                android:visibility="gone"
                />
        </LinearLayout>

        <!-- Row 2: Category Tag -->
        <TextView
            android:id="@+id/tv_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:textSize="11sp"
            android:textColor="#474554"
            android:background="@drawable/bg_status_pill"
            android:visibility="gone"
            />

        <!-- Row 3: Last Conversation Time -->
        <TextView
            android:id="@+id/tv_last_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:textColor="#787586"
            android:visibility="gone"
            />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#1A787586"
            android:layout_marginVertical="8dp"
            />

        <!-- Row 4: Buttons -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Dual Buttons: End + Continue -->
            <LinearLayout
                android:id="@+id/layout_dual_buttons"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/btn_end"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/btn_end_bg"
                    android:gravity="center"
                    android:text="结束对话"
                    android:textColor="#FF3B30"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="6dp"
                    />

                <TextView
                    android:id="@+id/btn_continue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:background="@drawable/btn_continue_bg"
                    android:gravity="center"
                    android:text="继续对话"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Single Button: Rate -->
            <LinearLayout
                android:id="@+id/layout_single_button"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center"
                android:visibility="gone"
                android:clipChildren="false">

                <TextView
                    android:id="@+id/btn_rate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/btn_continue_bg"
                    android:gravity="center"
                    android:text="评价景点"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_history.xml
  顶部搜索栏 + 标签固定在顶部，仅 RecyclerView 列表竖直滚动。
  移除了 clipChildren="false" 避免滚动时 item 闪动。
  所有 ID 保留兼容 HistoryActivity.java。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    tools:context=".view.user.HistoryActivity">

    <!-- ==================== Top Fixed Section ==================== -->
    <!-- 搜索栏 + 标签行，固定在顶部，不随列表滚动 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="40dp"
        android:paddingBottom="8dp"
        android:background="@color/login_background"
        android:elevation="2dp">

        <!-- ========== Search + Filter Row ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_history_search"
                android:paddingStart="44dp"
                android:paddingEnd="16dp"
                android:hint="@string/history_search_hint"
                android:textSize="14sp"
                android:textColor="@color/login_on_surface"
                android:textColorHint="@color/login_outline"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch"
                android:fontFamily="sans-serif"
                android:autofillHints="search"
                android:drawableStart="@drawable/ic_search_fit"
                android:drawablePadding="8dp" />

            <Button
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="@string/history_search_action"
                android:textSize="14sp"
                android:textColor="@color/login_on_primary"
                android:backgroundTint="@color/primary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- ========== 筛选标签 + 对话时间排序（并排） ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tag_all"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_history_tag"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/history_tag_all"
                        android:textColor="@color/txt_history_tag"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tag_theme_park"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_history_tag"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/history_tag_theme_park"
                        android:textColor="@color/txt_history_tag"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tag_museum"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_history_tag"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/history_tag_museum"
                        android:textColor="@color/txt_history_tag"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tag_nature_park"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_history_tag"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/history_tag_nature_park"
                        android:textColor="@color/txt_history_tag"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tag_scenic"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_history_tag"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/history_tag_scenic"
                        android:textColor="@color/txt_history_tag"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tag_history"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_history_tag"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/history_tag_history"
                        android:textColor="@color/txt_history_tag"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tag_ally"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_history_tag"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/history_tag_ally"
                        android:textColor="@color/txt_history_tag"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tag_zoo"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_history_tag"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/history_tag_zoo"
                        android:textColor="@color/txt_history_tag"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tag_morden"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_history_tag"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/history_tag_morden"
                        android:textColor="@color/txt_history_tag"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tv_sort_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawablePadding="2dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp"
                android:paddingVertical="4dp"
                android:text="@string/history_sort_desc"
                android:textColor="@color/login_outline"
                android:textSize="12sp"
                app:drawableEndCompat="@drawable/ic_expand_more" />
        </LinearLayout>

    </LinearLayout>

    <!-- 顶部分隔线（搜索/标签区 → 列表区的视觉过渡） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/primary_container" />

    <!-- ==================== SwipeRefreshLayout + RecyclerView ==================== -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_scenic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:overScrollMode="always" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ==================== Bottom Navigation Bar (Floating Pill) ==================== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/profile_surface_container_lowest"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp">

            <!-- 出游记录 Tab (Active) -->
            <LinearLayout
                android:id="@+id/tv_history"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_active"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginHorizontal="4dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_history"
                    app:tint="@color/profile_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/history_bottom_history"
                    android:textColor="@color/profile_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 中间 + 按钮 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_add_chat"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_nav_add_btn"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_nav_add" />
            </LinearLayout>

            <!-- 个人中心 Tab (Inactive) -->
            <LinearLayout
                android:id="@+id/tv_mine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginHorizontal="4dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_profile"
                    app:tint="@color/profile_outline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/history_bottom_profile"
                    android:textColor="@color/profile_outline"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

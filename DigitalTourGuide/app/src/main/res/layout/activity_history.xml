<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_history.xml
  Converted from Material You HTML home page design.
  Top header tabs removed per user request.
  All IDs preserved for HistoryActivity.java compatibility.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_background"
    android:clickable="true"
    android:focusable="true"
    android:clipChildren="false"
    tools:context=".view.user.HistoryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false">

        <!-- ==================== Top Fixed Section ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="4dp">

            <!-- ========== Hero Banner ========== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_history_hero"
                android:layout_marginBottom="16dp">

                <!-- Character illustration -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="100dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/history_hero_title"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp"
                        android:alpha="0.8"
                        android:fontFamily="sans-serif"
                        android:text="@string/history_hero_subtitle"
                        android:textColor="#999999"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_login_toggle_selected"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="8dp"
                        android:text="@string/history_hero_button"
                        android:textColor="@color/login_on_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="130dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-10dp"
                    android:layout_marginBottom="-10dp"
                    android:src="@drawable/ic_character"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <!-- ========== Search + Filter Row ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_history_search"
                    android:paddingStart="44dp"
                    android:paddingEnd="16dp"
                    android:hint="@string/history_search_hint"
                    android:textSize="14sp"
                    android:textColor="@color/login_on_surface"
                    android:textColorHint="@color/login_outline"
                    android:inputType="text"
                    android:maxLines="1"
                    android:fontFamily="sans-serif"
                    android:autofillHints="search"
                    android:drawableStart="@drawable/ic_search_fit"
                    android:drawablePadding="8dp" />

                <Button
                    android:id="@+id/btn_search"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="@string/history_search_action"
                    android:textSize="14sp"
                    android:textColor="@color/login_on_primary"
                    android:backgroundTint="#5241CD"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- ========== Tags (Horizontal Scroll) ========== -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="4dp"
                    android:baselineAligned="false">

                    <TextView
                        android:id="@+id/tag_all"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="@string/history_tag_all"
                        android:textSize="12sp"
                        android:textColor="@color/login_on_surface_variant"
                        android:background="@drawable/bg_history_tag"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tag_theme_park"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="@string/history_tag_theme_park"
                        android:textSize="12sp"
                        android:textColor="@color/login_on_surface_variant"
                        android:background="@drawable/bg_history_tag"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tag_museum"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="@string/history_tag_museum"
                        android:textSize="12sp"
                        android:textColor="@color/login_on_surface_variant"
                        android:background="@drawable/bg_history_tag"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tag_nature_park"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="@string/history_tag_nature_park"
                        android:textSize="12sp"
                        android:textColor="@color/login_on_surface_variant"
                        android:background="@drawable/bg_history_tag"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tag_scenic"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="@string/history_tag_scenic"
                        android:textSize="12sp"
                        android:textColor="@color/login_on_surface_variant"
                        android:background="@drawable/bg_history_tag"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tag_history"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="@string/history_tag_history"
                        android:textSize="12sp"
                        android:textColor="@color/login_on_surface_variant"
                        android:background="@drawable/bg_history_tag"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tag_ally"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="@string/history_tag_ally"
                        android:textSize="12sp"
                        android:textColor="@color/login_on_surface_variant"
                        android:background="@drawable/bg_history_tag"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tag_zoo"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="@string/history_tag_zoo"
                        android:textSize="12sp"
                        android:textColor="@color/login_on_surface_variant"
                        android:background="@drawable/bg_history_tag"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tag_morden"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:text="@string/history_tag_morden"
                        android:textSize="12sp"
                        android:textColor="@color/login_on_surface_variant"
                        android:background="@drawable/bg_history_tag"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:fontFamily="sans-serif"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>

        <!-- ==================== RecyclerView ==================== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_scenic"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipToPadding="false" />

        <!-- ==================== Bottom Navigation Bar (HTML style) ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:background="@drawable/bg_bottom_nav"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp"
            android:elevation="6dp">

            <!-- 出游记录 Tab (Active) -->
            <LinearLayout
                android:id="@+id/tv_history"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_travel_record"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_bottom_history"
                    android:textColor="@color/login_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- 中间 FAB 新建对话按钮 (floating above) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">


                <ImageView
                    android:id="@+id/iv_add_chat"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_add"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />


            </LinearLayout>

            <!-- 个人中心 Tab (Inactive) -->
            <LinearLayout
                android:id="@+id/tv_mine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_profile_normal"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_bottom_profile"
                    android:textColor="@color/login_on_surface_variant"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
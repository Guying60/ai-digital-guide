<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    android:fitsSystemWindows="true">

    <!-- 滚动内容区域（在底部按钮上方） -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btn_generate_test_video"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ======================== 分段导航栏（胶囊式切换） ======================== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_segment_container"
                android:orientation="horizontal"
                android:padding="3dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/tab_scenic"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="28dp"
                    android:background="@drawable/bg_segment_inactive"
                    android:text="景点编辑"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tab_digital_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="28dp"
                    android:background="@drawable/bg_segment_active"
                    android:text="数字人编辑"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ======================== 视频封面区域 ======================== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:contentPadding="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:contentDescription="数字人形象"
                        android:background="#F3F4F6"
                        android:src="@drawable/ic_aihuman_video" />

                    <!-- 更换数字人形象按钮 -->
                    <TextView
                        android:id="@+id/tv_upsert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_search"
                        android:elevation="2dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="更换数字人形象"
                        android:textColor="#333333"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <!-- ======================== 内容区域 ======================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <!-- ===== 文件大小提示 ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="24dp"
                    android:drawablePadding="6dp"
                    android:alpha="0.5"
                    android:text="最大支持上传 50MB 以内的 mp4 文件"
                    android:textSize="13sp"
                    android:textColor="#999999" />

                <!-- ===== 朗读文本要求 Section ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="朗读文本要求"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp"
                    android:layout_marginStart="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(朗读以下文本进行录制)"
                    android:textSize="14sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="4dp" />

                <!-- 朗读文本卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- 引号图标 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#8B5CF6"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:alpha="0.6"
                            android:layout_marginBottom="4dp"
                            android:text="“" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="欢迎来到本景区，我是您的专属导游。\n这里山水秀丽，历史底蕴深厚，\n每一处风景都值得细细品味。\n希望今天的游览能给您留下美好的记忆。"
                            android:textSize="14sp"
                            android:textColor="#444444"
                            android:lineSpacingExtra="4dp"
                            android:paddingStart="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#8B5CF6"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:alpha="0.6"
                            android:layout_marginTop="4dp"
                            android:layout_gravity="end"
                            android:text="&#8221;" />
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- ===== 视频录制要求 Section ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="视频录制要求"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="4dp" />

                <!-- 录制要求卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- 要求项 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_chip_selected"
                                android:alpha="0.7" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="正对摄像头，面部清晰无遮挡"
                                android:textSize="14sp"
                                android:textColor="#444444" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_chip_selected"
                                android:alpha="0.7" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="光线均匀，避免逆光"
                                android:textSize="14sp"
                                android:textColor="#444444" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_chip_selected"
                                android:alpha="0.7" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="自然语速朗读，不要刻意放慢"
                                android:textSize="14sp"
                                android:textColor="#444444" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_chip_selected"
                                android:alpha="0.7" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="录制时长建议 15 ~ 30 秒"
                                android:textSize="14sp"
                                android:textColor="#444444" />
                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- 隐藏的 VideoView（代码兼容） -->
                <VideoView
                    android:id="@+id/video_view"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 生成测试视频按钮（固定底部） -->
    <Button
        android:id="@+id/btn_generate_test_video"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#8B5CF6"
        android:elevation="4dp"
        android:stateListAnimator="@animator/btn_lift"
        android:foreground="?attr/selectableItemBackground"
        android:text="生成测试视频"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

</RelativeLayout>
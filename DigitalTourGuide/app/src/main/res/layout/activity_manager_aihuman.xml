<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- 滚动内容区域 -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btn_generate_test_video"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ======================== 分段导航栏（胶囊式切换） ======================== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_segment_container"
                android:orientation="horizontal"
                android:padding="3dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/tab_scenic"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="28dp"
                    android:background="@drawable/bg_segment_inactive"
                    android:text="景点编辑"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tab_digital_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="28dp"
                    android:background="@drawable/bg_segment_active"
                    android:text="数字人编辑"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ======================== 视频封面区域（9:16 竖屏） ======================== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                app:contentPadding="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ui_aihuman_stage_bg"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <FrameLayout
                        android:id="@+id/cover_frame"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:elevation="4dp"
                        android:foreground="?attr/selectableItemBackground"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="9:16"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.48">

                        <ImageView
                            android:id="@+id/iv_cover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/surface_variant"
                            app:cornerRadius="8dp"
                            android:contentDescription="数字人形象"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_aihuman_video" />

                        <!-- 更换数字人形象按钮 -->
                        <TextView
                            android:id="@+id/tv_upsert"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_search"
                            android:clickable="true"
                            android:elevation="2dp"
                            android:focusable="true"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="更换数字人形象"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </FrameLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- ======================== 内容区域 ======================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <!-- ===== 文件大小提示 ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="24dp"
                    android:drawablePadding="6dp"
                    android:alpha="0.5"
                    android:text="最大支持上传 50MB 以内的 mp4 文件"
                    android:textSize="13sp"
                    android:textColor="@color/muted" />

                <!-- ===== 视频录制要求 Section ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="视频录制要求"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp"
                    android:layout_marginStart="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="无需说话，录制一段静态画面即可"
                    android:textSize="14sp"
                    android:textColor="@color/muted"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="4dp" />

                <!-- 录制要求卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_chip_selected"
                                android:alpha="0.7" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="竖屏录制，画幅 9:16"
                                android:textSize="14sp"
                                android:textColor="@color/on_surface_variant" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_chip_selected"
                                android:alpha="0.7" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="正对摄像头，面部清晰无遮挡"
                                android:textSize="14sp"
                                android:textColor="@color/on_surface_variant" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_chip_selected"
                                android:alpha="0.7" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="光线均匀，避免逆光"
                                android:textSize="14sp"
                                android:textColor="@color/on_surface_variant" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_chip_selected"
                                android:alpha="0.7" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="保持静止姿态，不必开口讲话"
                                android:textSize="14sp"
                                android:textColor="@color/on_surface_variant" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_chip_selected"
                                android:alpha="0.7" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="录制时长建议 5 ~ 8 秒"
                                android:textSize="14sp"
                                android:textColor="@color/on_surface_variant" />
                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- ===== 音频文案要求 Section ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音频文案要求"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp"
                    android:layout_marginStart="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="请录制或上传与以下文案一致的音频"
                    android:textSize="14sp"
                    android:textColor="@color/muted"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="4dp" />

                <!-- 音频文案卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:alpha="0.6"
                            android:layout_marginBottom="4dp"
                            android:text="“" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="你好，我是数字人导游，欢迎来到灵山胜境景区"
                            android:textSize="14sp"
                            android:textColor="@color/on_surface_variant"
                            android:lineSpacingExtra="4dp"
                            android:paddingStart="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:alpha="0.6"
                            android:layout_marginTop="4dp"
                            android:layout_gravity="end"
                            android:text="&#8221;" />
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- 隐藏的 VideoView（代码兼容） -->
                <VideoView
                    android:id="@+id/video_view"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ======================== 全屏加载遮罩层 ======================== -->
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <androidx.cardview.widget.CardView
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="36dp">

                <!-- 旋转的加载圈 -->
                <ProgressBar
                    android:id="@+id/loading_spinner_overlay"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:indeterminateDrawable="@drawable/animation_loading_rotate" />

                <!-- 状态标题 -->
                <TextView
                    android:id="@+id/tv_loading_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="正在配置数字人"
                    android:textColor="@color/on_surface"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- 提示副标题 -->
                <TextView
                    android:id="@+id/tv_loading_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="请耐心等待，预计需要几分钟"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:gravity="center" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- 生成测试视频按钮（固定底部） -->
    <Button
        android:id="@+id/btn_generate_test_video"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/primary"
        android:elevation="4dp"
        android:stateListAnimator="@animator/btn_lift"
        android:foreground="?attr/selectableItemBackground"
        android:text="生成测试视频"
        app:cornerRadius="8dp"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded">

    <!-- 淡蓝标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:background="@color/profile_primary_container">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="修改年龄"
            android:textSize="18sp"
            android:textColor="@color/profile_on_primary_container"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 输入区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/et_age_dialog"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="请输入年龄"
            android:maxLength="3"
            android:inputType="number"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/bg_input_rounded"
            android:paddingHorizontal="16dp"
            android:textColor="@color/profile_on_surface"
            android:textColorHint="@color/profile_outline" />

        <!-- 按钮区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center">

            <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="取消"
            android:textSize="16sp"
            android:textColor="@color/profile_on_surface_variant"
            android:background="@drawable/bg_btn_outline" />

            <TextView
            android:id="@+id/tv_confirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="确认"
            android:textSize="16sp"
            android:textColor="@color/profile_on_primary_container"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
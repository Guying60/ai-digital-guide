<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ===== TopAppBar：无返回，字幕图标在右上 ===== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface">

        <!-- 字幕切换按钮（右上角） -->
        <ImageView
            android:id="@+id/tv_subtitle_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:src="@drawable/ic_text"
            android:contentDescription="字幕"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- ===== 中间内容区：数字人全屏背景 + 浮层 ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bubble_user"
        tools:ignore="MissingClass,InflatedId,All">

        <!-- 数字人区域 -->
        <TextureView
            android:id="@+id/tv_digital_human"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 数字人待机视频 -->
        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/idle_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@color/on_surface"
            app:surface_type="texture_view"
            app:use_controller="false"
            app:resize_mode="zoom" />

        <!-- 拍摄画面预览（右上角浮层） -->
        <androidx.camera.view.PreviewView
            android:id="@+id/preview_view_camera"
            android:layout_width="120dp"
            android:layout_height="160dp"
            android:layout_margin="16dp"
            android:background="@color/outline_variant"
            android:layout_gravity="end|top" />

        <!-- ===== AI路线数轴（悬浮，可拖动） ===== -->
        <com.example.digitaltourguide.view.user.RouteTimelineView
            android:id="@+id/route_timeline"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="105dp"
            android:background="@drawable/bg_route_timeline" />

        <!-- ===== 字幕区域（悬浮，位于路线下方靠近输入栏） ===== -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="bottom"
            android:maxLines="8"
            android:textColor="@color/white"
            android:scrollbars="vertical"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="12dp"
            android:alpha="0.92"
            android:background="@drawable/bg_subtitle_overlay" />

    </FrameLayout>

    <!-- ===== 文本输入栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/surface">

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:maxLines="3" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发送"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/chart_line_primary"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ===== 底部功能栏：麦克风/拍照/拍摄 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:background="@color/surface">

        <ImageView
            android:id="@+id/btn_mic"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginEnd="40dp"
            android:src="@drawable/ic_mic_blue_de"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_circle_shadow"
            android:elevation="6dp"
            android:outlineProvider="background"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="麦克风" />

        <ImageView
            android:id="@+id/btn_capture"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_call_end"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_circle_shadow"
            android:elevation="8dp"
            android:outlineProvider="background"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="拍照" />

        <ImageView
            android:id="@+id/btn_camera"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginStart="40dp"
            android:src="@drawable/ic_video_de"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_circle_shadow"
            android:elevation="6dp"
            android:outlineProvider="background"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="摄像" />
    </LinearLayout>

</LinearLayout>
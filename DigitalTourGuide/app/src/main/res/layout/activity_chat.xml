<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#333333"
    >

    <!-- 顶部栏：结束对话 + 音色下拉 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/tv_subtitle_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_text"
            android:textSize="16sp"
            android:clickable="true"
            android:padding="6dp"
            />

        <!-- 顶部结束对话按钮 -->
        <TextView
            android:id="@+id/btn_end_chat"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:text="结束对话"
            android:textColor="#FF3B30"
            android:background="@drawable/tag_bg"
           android:gravity="center"
            android:layout_marginLeft="90dp"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- 中间内容区：数字人全屏背景 + 拍摄画面浮层 -->
    <FrameLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:ignore="MissingClass,InflatedId,,All">

        <!-- 数字人区域（全屏填充）。H.264 MediaCodec 硬解直渲到 TextureView -->
        <TextureView
            android:id="@+id/tv_digital_human"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />

        <!-- 拍摄画面预览（右上角浮层） -->
        <androidx.camera.view.PreviewView
            android:id="@+id/preview_view_camera"
            android:layout_width="120dp"
            android:layout_height="160dp"
            android:layout_margin="16dp"
            android:background="#cccccc"
            android:layout_gravity="end|top" />

    </FrameLayout>

    <!-- 字幕区域（数字人下方、图标上方） -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:maxLines="8"
        android:scrollbars="vertical"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="8dp"
        android:background="#333333"/>

    <!-- 新增：文本输入栏（水平布局） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#333333">

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="输入文本进行对话"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:maxLines="3" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发送"
            android:textColor="@android:color/white"
            android:backgroundTint="#4ECDC4"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:textSize="16sp"/>

    </LinearLayout>

    <!-- 底部功能栏：麦克风/拍照/拍摄相关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:background="#333333">

        <ImageView
            android:id="@+id/btn_mic"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_mico"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="40dp"
            />

        <ImageView
            android:id="@+id/btn_capture"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/ic_capture"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView
            android:id="@+id/btn_camera"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_video"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="40dp"
            />

    </LinearLayout>

</LinearLayout>
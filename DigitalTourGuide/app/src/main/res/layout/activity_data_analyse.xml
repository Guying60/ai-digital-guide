<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FB"
    android:orientation="vertical">

    <!-- ======================== 标题栏 ======================== -->
    <RelativeLayout
        android:id="@+id/ll_tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F8F9FB"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- 返回按钮 -->
        <TextView
            android:id="@+id/tv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:text="←"
            android:textColor="#1F2937"
            android:textSize="22sp" />

        <!-- 标题（居中） -->
        <TextView
            android:id="@+id/tv_overview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="数据看板"
            android:textColor="#1F2937"
            android:textSize="18sp"
            android:textStyle="normal" />

        <!-- 右侧占位，保持标题居中 -->
        <View
            android:layout_width="48dp"
            android:layout_height="0dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />

    </RelativeLayout>

    <!-- ======================== 可滚动内容 ======================== -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- ═══════════════════════════════════════════ -->
            <!-- 服务人次趋势                              -->
            <!-- ═══════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 标题行 -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_total_people"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="总人次：0"
                            android:textColor="#1F2937"
                            android:textSize="16sp"
                            android:textStyle="normal" />

                        <Spinner
                            android:id="@+id/spinner_people"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_spinner_pill"
                            android:entries="@array/date_options"
                            android:paddingHorizontal="12dp" />
                    </RelativeLayout>

                    <!-- 折线图 -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/line_chart_people"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="16dp" />

                    <ProgressBar
                        android:id="@+id/progress_people"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ═══════════════════════════════════════════ -->
            <!-- FAQ 统计 (热门问题TOP10)                   -->
            <!-- ═══════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 标题行 -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="FAQ统计 (热门问题TOP10)"
                            android:textColor="#1F2937"
                            android:textSize="16sp"
                            android:textStyle="normal" />

                        <Spinner
                            android:id="@+id/spinner_qa"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_spinner_pill"
                            android:entries="@array/date_options"
                            android:paddingHorizontal="12dp" />
                    </RelativeLayout>

                    <ProgressBar
                        android:id="@+id/progress_qa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:visibility="gone" />

                    <!-- 柱状图自定义 View -->
                    <com.example.digitaltourguide.utils.HotFaqBarChart
                        android:id="@+id/hot_faq_bar_chart"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:layout_marginTop="12dp"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_empty_qa"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="center"
                        android:text="暂无数据"
                        android:textColor="#9CA3AF"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ═══════════════════════════════════════════ -->
            <!-- 满意度趋势                                -->
            <!-- ═══════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 标题行 -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_avg_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:text="满意度趋势"
                            android:textColor="#1F2937"
                            android:textSize="16sp"
                            android:textStyle="normal" />

                        <Spinner
                            android:id="@+id/spinner_score"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_spinner_pill"
                            android:entries="@array/date_options"
                            android:paddingHorizontal="12dp" />
                    </RelativeLayout>

                    <!-- 折线图 -->
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/line_chart_satisfaction"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="16dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- ======================== 底部导航 ======================== -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <!-- 数据预览（选中） -->
        <LinearLayout
            android:id="@+id/tab_data_analysis"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/iv_icon_data"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_data_selected"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_text_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="数据预览"
                android:textColor="#5A32FA"
                android:textSize="12sp"
                android:textStyle="normal" />
        </LinearLayout>

        <!-- 游客分析（未选中） -->
        <LinearLayout
            android:id="@+id/tab_tourist_analysis"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/iv_icon_tourist"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tourist_normal"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_text_analysis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="游客分析"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:textStyle="normal" />
        </LinearLayout>

    </LinearLayout>

    <!-- Tooltip 卡片（动态添加，保留 id 引用） -->
    <TextView
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_surface_container_low"
    android:orientation="vertical"
    android:paddingBottom="80dp">

    <!-- ===================== Scrollable Content ===================== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- 1️⃣ 用户信息卡片                                    -->
            <!-- ═══════════════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_user_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/profile_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:contentPadding="20dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- 主行：头像 + 文字信息 + 箭头 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- 头像 (加大 + 外圈) -->
                        <FrameLayout
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:background="@drawable/bg_circle_avatar_border">

                            <ImageView
                                android:id="@+id/iv_avatar"
                                android:layout_width="68dp"
                                android:layout_height="68dp"
                                android:layout_gravity="center"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_person_filled"
                                android:contentDescription="@null"
                                android:background="@drawable/bg_circle_avatar" />
                        </FrameLayout>

                        <!-- 文字区 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_nickname"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="旅行小达人"
                                android:textColor="@color/profile_on_surface"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_user_id"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ID: 12345678"
                                    android:textColor="@color/profile_outline"
                                    android:textSize="14sp" />

                                <!-- 性别 → 改用 M3 Chip 组件 -->
                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chip_gender"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="♂ 男"
                                    android:textColor="@color/profile_on_primary_container"
                                    android:textSize="12sp"
                                    app:chipBackgroundColor="@color/profile_primary_container"
                                    app:chipCornerRadius="20dp"
                                    app:chipMinHeight="26dp"
                                    app:chipStrokeWidth="0dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 箭头 -->
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:layout_marginBottom="8dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/profile_outline" />

                    </LinearLayout>

                    <!-- 等级徽章 → 改用 M3 Chip 组件，右下角 -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_user_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:text=" 普通用户"
                        android:textColor="@color/profile_on_primary"
                        android:textSize="11sp"
                        app:chipBackgroundColor="@color/profile_primary"
                        app:chipCornerRadius="20dp"
                        app:chipIcon="@drawable/ic_stars"
                        app:chipIconTint="@color/profile_on_primary"
                        app:chipIconSize="16dp"
                        app:chipMinHeight="28dp"
                        app:chipStrokeWidth="0dp" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- 2️⃣ 我的服务                                        -->
            <!-- ═══════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginStart="4dp"
                android:text="我的服务"
                android:textColor="@color/profile_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/profile_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:contentPadding="16dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- 我的评价 -->
                    <LinearLayout
                        android:id="@+id/btn_my_reviews"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:paddingVertical="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/profile_primary_container"
                            app:strokeWidth="0dp"
                            app:contentPadding="0dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_rate_review"
                                app:tint="@color/profile_primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="我的评价"
                            android:textColor="@color/profile_on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="查看全部评价"
                            android:textColor="@color/profile_outline"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 偏好设置 -->
                    <LinearLayout
                        android:id="@+id/card_preferences"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:paddingVertical="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/profile_secondary_container"
                            app:strokeWidth="0dp"
                            app:contentPadding="0dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_auto_awesome"
                                app:tint="@color/profile_on_secondary_container" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="偏好设置"
                            android:textColor="@color/profile_on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="定制专属体验"
                            android:textColor="@color/profile_outline"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- 3️⃣ 账户与安全                                      -->
            <!-- ═══════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginStart="4dp"
                android:text="账户与安全"
                android:textColor="@color/profile_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/profile_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:contentPadding="8dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_list"
                    android:dividerPadding="20dp"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <!-- 账号管理 -->
                    <LinearLayout
                        android:id="@+id/btn_account_mgmt"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/profile_surface_container_low"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:contentPadding="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_person_outline"
                                app:tint="@color/profile_primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="账号管理"
                                android:textColor="@color/profile_on_surface"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="个人信息与安全设置"
                                android:textColor="@color/profile_outline"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/profile_outline_variant" />
                    </LinearLayout>

                    <!-- 修改密码 -->
                    <LinearLayout
                        android:id="@+id/btn_change_pwd"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/profile_surface_container_low"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:contentPadding="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_lock"
                                app:tint="@color/profile_primary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="修改密码"
                                android:textColor="@color/profile_on_surface"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="定期更换保障安全"
                                android:textColor="@color/profile_outline"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- 隐私设置 -->
                    <LinearLayout
                        android:id="@+id/btn_privacy"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/profile_surface_container_low"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:contentPadding="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_shield"
                                app:tint="@color/profile_secondary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="隐私设置"
                                android:textColor="@color/profile_on_surface"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="管理数据与隐私权限"
                                android:textColor="@color/profile_outline"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/profile_outline_variant" />
                    </LinearLayout>

                    <!-- 关于我们 -->
                    <LinearLayout
                        android:id="@+id/btn_about"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/profile_surface_container_low"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:contentPadding="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_info"
                                app:tint="@color/profile_outline" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="关于我们"
                                android:textColor="@color/profile_on_surface"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="了解应用与团队"
                                android:textColor="@color/profile_outline"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/profile_outline_variant" />
                    </LinearLayout>

                    <!-- 帮助与反馈 -->
                    <LinearLayout
                        android:id="@+id/btn_help"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            app:cardBackgroundColor="@color/profile_surface_container_low"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:contentPadding="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_help"
                                app:tint="@color/profile_secondary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="帮助与反馈"
                                android:textColor="@color/profile_on_surface"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="遇到问题？联系我们"
                                android:textColor="@color/profile_outline"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/profile_outline_variant" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- 4️⃣ 退出登录                                        -->
            <!-- ═══════════════════════════════════════════════════ -->
            <Button
                android:id="@+id/btnSignOut"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/profile_error_container"
                android:text="退出登录"
                android:textColor="@color/profile_on_error_container"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="@color/profile_on_error_container"
                app:rippleColor="@color/profile_error" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/profile_outline_variant" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 底部导航栏 (M3 Navigation Bar 风格)                       -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/profile_surface"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:paddingHorizontal="16dp">

        <!-- 顶部分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/profile_outline_variant"
            android:layout_gravity="top" />

        <!-- 出游记录 -->
        <LinearLayout
            android:id="@+id/tag_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_assignment"
                app:tint="@color/profile_on_surface_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="出游记录"
                android:textColor="@color/profile_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 新建对话 (FAB) -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginBottom="-20dp"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/iv_add"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_fab"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="16dp"
                android:scaleType="center"
                android:src="@drawable/ic_add" />
        </FrameLayout>

        <!-- 个人中心 (选中态) -->
        <LinearLayout
            android:id="@+id/tv_mine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingVertical="4dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:gravity="center"
                app:cardBackgroundColor="@color/profile_primary_container"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_person_filled"
                    app:tint="@color/profile_primary" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="个人中心"
                android:textColor="@color/profile_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>


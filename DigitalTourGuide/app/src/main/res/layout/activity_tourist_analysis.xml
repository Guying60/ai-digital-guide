<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="#F8F9FA"
    android:id="@+id/scrollView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="13dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="主要指标"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <Spinner
                android:id="@+id/spinner_time_card"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="#F0F0F0"
                android:entries="@array/time_range_options" />

        </LinearLayout>

        <!-- 数据指标卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="120dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/blue_str"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="正面情感占比"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#35CBCB"/>

                <TextView
                    android:id="@+id/tv_positive_rate_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="86%"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/tv_positive_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑21% 较上月"
                    android:textSize="12sp"
                    android:textColor="#388E3C"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="120dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/green_str"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="高频关注点"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/tv_top_focus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="餐饮"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:textColor="#388E3C"/>

                <TextView
                    android:id="@+id/tv_top_focus_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="占所有问题71%"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="120dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/red_str"
               >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="待改善"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B6B"/>

                <TextView
                    android:id="@+id/tv_worst_focus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="停车"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:textColor="#D32F2F"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="负面评价最集中"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>

        <!-- AI 提示卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E3F2FD"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            >

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/bulb"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AI建议已生成，点击跳转"
                android:textSize="15sp"
                android:textColor="#1565C0"/>

            <Button
                android:id="@+id/btn_scroll_to_suggestion"
                android:layout_width="100dp"
                android:layout_height="43dp"
                android:text="查看分析"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="@color/white"
                android:textColor="#2196F3"
                android:minWidth="80dp"/>
        </LinearLayout>
        </LinearLayout>

        <!-- 时间筛选 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="时间范围："
                android:textSize="14sp"
                android:textColor="#444444"/>

            <Spinner
                android:id="@+id/spinner_time_range"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="#F0F0F0"
                android:paddingHorizontal="8dp"
                android:entries="@array/time_range_options" />
        </LinearLayout>

        <!-- 分割线 -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="5dp"
            android:background="@drawable/bg_card_white"
            >

        <!-- 情感趋势图表 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="情感分布趋势（%）"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/line_chart_emotion"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="#FFFFFF"
            android:padding="8dp"/>


        <!-- 情感分布饼图 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="整体情感分布"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pie_chart_emotion"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="#FFFFFF"
            android:padding="8dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFA500"
            android:layout_marginVertical="16dp"/>

        </LinearLayout>

        <!-- 服务建议 -->
        <LinearLayout
            android:id="@+id/ll_suggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#E3F2FD"
            android:orientation="vertical"
            android:padding="16dp"
           >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI建议"
                android:textColor="#1565C0"
                android:textSize="15sp"
                android:textStyle="bold"/>

                <!-- 占位，把时间挤到右边 -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#666666"
                    android:text="每日21:00自动生成"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_suggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="暂无AI生成建议"
                android:textColor="#999999"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>


        <!-- 底部导航 -->
        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@android:color/white"
            android:paddingVertical="12dp">

            <!-- 数据分析 -->
            <LinearLayout
                android:id="@+id/tab_scenic_manage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_icon_data"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_data_normal"
                    />

                <TextView
                    android:id="@+id/tv_text_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="数据分析"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <!-- 景点管理（当前选中） -->
            <LinearLayout
                android:id="@+id/tab_data_analysis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_icon_scenic"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_tourist_selected"
                   />

                <TextView
                    android:id="@+id/tv_text_scenic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="景点管理"
                    android:textSize="12sp"
                    android:textColor="#007AFF"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
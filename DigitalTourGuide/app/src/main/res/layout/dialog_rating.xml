<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded">

    <!-- ── 标题 ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="为本次体验评分"
        android:textColor="@color/profile_on_surface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- ── 星星评分 (可点击) ── -->
    <LinearLayout
        android:id="@+id/star_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/star_1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="1星"
            android:src="@drawable/ic_star_filled" />

        <ImageView
            android:id="@+id/star_2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="2星"
            android:src="@drawable/ic_star_filled" />

        <ImageView
            android:id="@+id/star_3"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="3星"
            android:src="@drawable/ic_star_filled" />

        <ImageView
            android:id="@+id/star_4"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="4星"
            android:src="@drawable/ic_star_filled" />

        <ImageView
            android:id="@+id/star_5"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="5星"
            android:src="@drawable/ic_star_filled" />
    </LinearLayout>

    <!-- ── 评分标签 (可点击切换) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tag_professional"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_rating"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="讲解专业"
            android:textColor="@color/profile_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tag_rich"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tag_rating"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="内容丰富"
            android:textColor="@color/profile_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tag_fun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tag_rating"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="互动有趣"
            android:textColor="@color/profile_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tag_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_rating"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="讲解清晰"
            android:textColor="@color/profile_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tag_knowledgeable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tag_rating"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="知识丰富"
            android:textColor="@color/profile_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tag_excellent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tag_rating"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="体验极佳"
            android:textColor="@color/profile_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ── 文本输入区 ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <EditText
            android:id="@+id/edit_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_rounded"
            android:gravity="top|start"
            android:hint="分享一下您的体验感受吧..."
            android:inputType="textMultiLine"
            android:maxLength="200"
            android:minHeight="100dp"
            android:padding="12dp"
            android:paddingBottom="32dp"
            android:textColor="@color/profile_on_surface"
            android:textColorHint="@color/profile_outline"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_char_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="12dp"
            android:text="0/200"
            android:textColor="@color/profile_outline"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- ── 按钮区 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/profile_surface_container"
            android:text="取消"
            android:textColor="@color/profile_on_surface_variant"
            android:textSize="14sp"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/profile_primary"
            android:text="提交"
            android:textColor="@color/profile_on_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
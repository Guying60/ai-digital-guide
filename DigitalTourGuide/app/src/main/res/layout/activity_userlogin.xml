<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_login_gradient"
    android:gravity="center_horizontal"
    tools:context=".view.user.UserLoginActivity">

    <!-- 顶部Logo和标题区域 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="28dp">

        <!-- 图标位置：这里你可以替换为设计图中的机器人图标 -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@mipmap/bg_ai_robot"
            android:contentDescription="@null"/>

        <!-- AI导游主标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="AI导游"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#2196F3"
            android:letterSpacing="0.02"
            android:layout_marginTop="8dp"/>

        <!-- 副标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="你的24h智能旅行助手"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- 登录卡片容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_edittext_rounded"
        android:padding="10dp"
        android:layout_marginHorizontal="24dp"
        android:gravity="center_horizontal">

        <!-- 用户登录标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="用户登录"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <!-- 探索全球景点标语 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="探索全球景点    AI导游伴你"
            android:textSize="12sp"
            android:textColor="#2196F3"
            android:layout_marginBottom="24dp" />

        <!-- 用户类型切换：普通用户 / 管理员 (保留原有tv_admin_login变量名) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp"
            android:background="#F0F0F0"
            android:padding="4dp"
            android:clipToPadding="false">

            <!-- 普通用户选项 (新增，但无id冲突) -->
            <TextView
                android:id="@+id/tv_normal_user"
                android:layout_width="0dp"
                android:layout_height="37dp"
                android:layout_weight="1"
                android:text="普通用户"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/bg_switch_normal_selected"
                android:clickable="true"
                android:focusable="true" />

            <!-- 管理员选项，保留原tv_admin_login id，样式为未选中状态 -->
            <TextView
                android:id="@+id/tv_admin_login"
                android:layout_width="0dp"
                android:layout_height="37dp"
                android:layout_weight="1"
                android:text="管理员"
                android:textSize="16sp"
                android:textColor="#666666"
                android:gravity="center"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- 账号输入区域 (保留原有et_username) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="账号："
                android:textSize="15sp"
                android:textColor="#000000"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="请输入账号"
                android:inputType="text"
                android:background="@null"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:textSize="16sp"
                android:textColor="#333333"

                android:layout_marginTop="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"/>
        </LinearLayout>

        <!-- 密码输入区域 (保留原有et_password) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="密码："
                android:textSize="15sp"
                android:textColor="#000000"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp">

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:hint="请输入密码"
                    android:inputType="textPassword"
                    android:background="@null"
                    android:paddingStart="0dp"
                    android:paddingEnd="48dp"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    />

                <ImageView
                    android:id="@+id/iv_pwd_visibility"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_eye_close"
                    android:contentDescription="@null"/>
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"/>
        </LinearLayout>

        <!-- 记住密码 & 自动登录 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <CheckBox
                android:id="@+id/cb_remember_password"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="记住密码"
                android:textSize="12sp"
                android:textColor="#455A64"
                android:buttonTint="#00BCD4" />

            <CheckBox
                android:id="@+id/cb_auto_login"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="下次自动登录"
                android:textSize="12sp"
                android:textColor="#455A64"
                android:layout_marginStart="16dp"
                android:buttonTint="#00BCD4" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="37dp"
            android:text="登录"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_rounded"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- 新用户注册按钮 -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_register"
            android:layout_width="match_parent"
            android:layout_height="37dp"
            android:text="新用户注册"
            android:textSize="14sp"
            android:textColor="#35CBCB"
            android:background="@drawable/bg_register_rounded"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

    <!-- 底部占位，防止内容贴底 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"
         />

</LinearLayout>
</LinearLayout>
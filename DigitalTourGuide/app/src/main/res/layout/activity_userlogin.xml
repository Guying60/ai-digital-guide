<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_userlogin.xml
  Converted from the Material You HTML login design.
  Maintains backward-compatible IDs: et_username, et_password, tv_admin_login,
  cb_remember_password, btn_login, tv_register, iv_pwd_visibility.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ui_login_bg"
    tools:context=".view.user.UserLoginActivity">

    <!-- ==================== Ambient Background Gradient ==================== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_login_ambient" />

    <!-- ==================== Scrollable Content ==================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- ========== Header ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textSize="28sp"
                android:textColor="@color/login_on_surface"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.0"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_subtitle"
                android:textSize="14sp"
                android:textColor="@color/login_on_surface_variant"
                android:fontFamily="sans-serif"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="28dp" />

            <!-- ========== Segmented Pill Toggle (with sliding indicator) ========== -->
            <FrameLayout
                android:id="@+id/toggle_container"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="28dp"
                android:padding="4dp">

                <!-- Container background -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_login_toggle_container" />

                <!-- Sliding purple indicator -->
                <View
                    android:id="@+id/toggle_indicator"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_login_toggle_selected" />

                <!-- Tab labels (must be on top) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:elevation="4dp">

                    <!-- Normal User (selected by default) -->
                    <TextView
                        android:id="@+id/tv_normal_user"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/login_tab_normal"
                        android:textSize="13sp"
                        android:textColor="@color/login_on_primary"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Admin User -->
                    <TextView
                        android:id="@+id/tv_admin_login"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/login_tab_admin"
                        android:textSize="13sp"
                        android:textColor="@color/login_on_surface_variant"
                        android:gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </FrameLayout>

            <!-- ========== Account Input ========== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp">

                <!-- Person Icon -->
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_person_outline"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <!-- Input -->
                <EditText
                    android:id="@+id/et_username"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_login_input_selector"
                    android:paddingStart="44dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:hint="@string/login_username_hint"
                    android:textSize="14sp"
                    android:textColor="@color/login_on_surface"
                    android:textColorHint="@color/login_outline_variant"
                    android:inputType="text"
                    android:fontFamily="sans-serif"
                    android:autofillHints="username"
                    android:gravity="center_vertical" />
            </FrameLayout>

            <!-- ========== Password Input ========== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp">

                <!-- Lock Icon -->
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_lock"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <!-- Password Input -->
                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_login_input_selector"
                    android:paddingStart="44dp"
                    android:paddingEnd="48dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:hint="@string/login_password_hint"
                    android:textSize="14sp"
                    android:textColor="@color/login_on_surface"
                    android:textColorHint="@color/login_outline_variant"
                    android:inputType="textPassword"
                    android:fontFamily="sans-serif"
                    android:autofillHints="password"
                    android:gravity="center_vertical" />
                <ImageView
                    android:id="@+id/iv_pwd_visibility"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_eye_close"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/login_toggle_visibility"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- ========== Actions Row (Remember me + Forgot password) ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:layout_marginBottom="24dp">

                <!-- Remember Password Checkbox -->
                <CheckBox
                    android:id="@+id/cb_remember_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/login_remember_password"
                    android:textSize="12sp"
                    android:textColor="@color/login_on_surface_variant"
                    android:fontFamily="sans-serif-medium"
                    android:buttonTint="@color/login_primary" />

                <!-- Forgot Password -->
                <TextView
                    android:id="@+id/tv_forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_forgot_password"
                    android:textSize="12sp"
                    android:textColor="@color/login_primary"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ========== Login Button ========== -->
            <TextView
                android:id="@+id/btn_login"
                android:layout_width="match_parent"
                android:layout_height="47dp"
                android:text="@string/login_button"
                android:textSize="16sp"
                android:textColor="@color/login_on_primary"
                android:gravity="center"
                android:background="@drawable/bg_login_toggle_selected"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:letterSpacing="0.02"
                android:layout_marginBottom="32dp" />

            <!-- ========== Footer ========== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_no_account"
                    android:textSize="14sp"
                    android:textColor="@color/login_on_surface_variant"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/tv_register"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_register_now"
                    android:textSize="14sp"
                    android:textColor="@color/login_primary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
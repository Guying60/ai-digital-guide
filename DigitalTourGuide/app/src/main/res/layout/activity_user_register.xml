<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_user_register.xml
  Converted from the Material You HTML registration design.
  Maintains backward-compatible IDs: et_nickname, et_username, et_password,
  et_confirm_password, btn_register.
  Uses 确认密码 (not verification code) to match existing Java logic.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ui_register_bg"
    tools:context=".view.user.UserRegisterActivity">

    <!-- ==================== Ambient Background Gradient ==================== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_login_ambient" />

    <!-- ==================== Scrollable Content ==================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="32dp">

            <!-- ========== Header ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用户注册"
                android:textSize="28sp"
                android:textColor="@color/login_on_surface"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.0"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_subtitle"
                android:textSize="14sp"
                android:textColor="@color/login_on_surface_variant"
                android:fontFamily="sans-serif"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="28dp" />

            <!-- ========== Nickname Input ========== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_person_outline"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/et_nickname"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_login_input_selector"
                    android:paddingStart="44dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:hint="@string/register_nickname_hint"
                    android:textSize="14sp"
                    android:textColor="@color/login_on_surface"
                    android:textColorHint="@color/login_outline_variant"
                    android:inputType="text"
                    android:fontFamily="sans-serif"
                    android:autofillHints="username"
                    android:gravity="center_vertical" />
            </FrameLayout>

            <!-- ========== Account Input ========== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_mail"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/et_username"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_login_input_selector"
                    android:paddingStart="44dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:hint="@string/register_username_hint"
                    android:textSize="14sp"
                    android:textColor="@color/login_on_surface"
                    android:textColorHint="@color/login_outline_variant"
                    android:inputType="text"
                    android:fontFamily="sans-serif"
                    android:autofillHints="username"
                    android:gravity="center_vertical" />
            </FrameLayout>

            <!-- ========== Password Input ========== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_lock"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_login_input_selector"
                    android:paddingStart="44dp"
                    android:paddingEnd="48dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:hint="@string/register_password_hint"
                    android:textSize="14sp"
                    android:textColor="@color/login_on_surface"
                    android:textColorHint="@color/login_outline_variant"
                    android:inputType="textPassword"
                    android:fontFamily="sans-serif"
                    android:autofillHints="password"
                    android:gravity="center_vertical" />

                <ImageView
                    android:id="@+id/iv_pwd_visibility"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_eye_close"
                    android:contentDescription="@string/register_toggle_visibility"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- ========== Confirm Password Input (NOT verification code) ========== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_verified_user"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/et_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_login_input_selector"
                    android:paddingStart="44dp"
                    android:paddingEnd="48dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:hint="@string/register_confirm_hint"
                    android:textSize="14sp"
                    android:textColor="@color/login_on_surface"
                    android:textColorHint="@color/login_outline_variant"
                    android:inputType="textPassword"
                    android:fontFamily="sans-serif"
                    android:autofillHints="password"
                    android:gravity="center_vertical" />

                <ImageView
                    android:id="@+id/iv_pwd_visibility_confirm"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_eye_close"
                    android:contentDescription="@string/register_toggle_visibility"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- ========== Terms Checkbox ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp">

                <CheckBox
                    android:id="@+id/cb_terms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/login_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_terms_prefix"
                    android:textSize="12sp"
                    android:textColor="@color/login_on_surface_variant"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_terms_agreement"
                    android:textSize="12sp"
                    android:textColor="@color/login_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_terms_and"
                    android:textSize="12sp"
                    android:textColor="@color/login_on_surface_variant"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_terms_privacy"
                    android:textSize="12sp"
                    android:textColor="@color/login_primary"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <!-- ========== Register Button ========== -->
            <TextView
                android:id="@+id/btn_register"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/register_button"
                android:textSize="16sp"
                android:textColor="@color/background"
                android:gravity="center"
                android:background="@drawable/bg_login_btn"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:letterSpacing="0.02" />

            <!-- ========== Footer ========== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_has_account"
                    android:textSize="14sp"
                    android:textColor="@color/login_on_surface_variant"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/user_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_login_link"
                    android:textSize="14sp"
                    android:textColor="@color/login_primary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
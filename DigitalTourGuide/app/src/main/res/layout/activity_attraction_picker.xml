<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_background"
    android:orientation="vertical">

    <!-- ===================== TopAppBar ===================== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/profile_surface"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="选择景点"
        app:titleTextColor="@color/profile_primary"
        app:titleCentered="true"
        app:titleTextAppearance="@style/TextAppearance_Profile_Title">

        <TextView
            android:id="@+id/tv_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="···"
            android:textColor="@color/profile_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="invisible" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- ===================== Search Bar ===================== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@color/profile_surface">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_rounded"
            android:drawableStart="@drawable/ic_search_vector"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:hint="搜索景点名称"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/profile_on_surface"
            android:textColorHint="@color/profile_outline"
            android:textSize="14sp" />
    </FrameLayout>

    <!-- ===================== Attractions List ===================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_attractions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="80dp" />

</LinearLayout>
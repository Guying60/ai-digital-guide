<?xml version="1.0" encoding="utf-8"?>
<!--
  dialog_test_video_text.xml — 生成测试视频弹窗
  Material 风格，文本输入 + 预置按钮
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <!-- ========== 标题栏 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_video"
            app:tint="@color/profile_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="生成测试视频"
            android:textColor="@color/profile_on_surface"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- ========== 分隔线 ========== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="20dp"
        android:alpha="0.4"
        android:background="@color/profile_surface_variant" />

    <!-- ========== 输入区域 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_rounded"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="朗读文本（可选）"
            android:textColor="@color/profile_on_surface"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_test_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@android:color/transparent"
            android:fontFamily="sans-serif"
            android:gravity="top|start"
            android:hint="请输入朗读文本，不填则使用默认问候语"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:padding="12dp"
            android:textColor="@color/profile_on_surface"
            android:textColorHint="@color/profile_outline"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ========== 底部操作按钮 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_test"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="取消"
            android:textColor="@color/profile_outline"
            android:textSize="14sp"
            app:cornerRadius="22dp"
            app:rippleColor="@color/profile_surface_container" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generate"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.5"
            android:layout_marginStart="10dp"
            android:text="生成"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:backgroundTint="@color/profile_primary"
            app:cornerRadius="22dp"
            app:rippleColor="@color/profile_primary_container" />
    </LinearLayout>

</LinearLayout>
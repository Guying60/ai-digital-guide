<?xml version="1.0" encoding="utf-8"?>
<!-- Input field background in focused state – primary border instead of variant -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="0dp"
        android:top="2dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#08000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/login_surface" />
            <stroke
                android:width="1.5dp"
                android:color="@color/login_primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
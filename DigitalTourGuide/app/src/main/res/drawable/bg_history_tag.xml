<?xml version="1.0" encoding="utf-8"?>
<!-- Tag chip for history page - selector: filled primary when selected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/profile_primary" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/login_surface_container_low" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
<?xml version="1.0" encoding="utf-8"?>
<!-- Glass panel background for profile cards -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item
        android:left="0dp"
        android:top="4dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Glass background with border -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/profile_glass_white" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
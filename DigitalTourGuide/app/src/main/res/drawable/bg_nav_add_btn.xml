<?xml version="1.0" encoding="utf-8"?>
<!-- 底部导航栏：中间 + 按钮背景（品牌色圆形 + 阴影） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 阴影层 -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#33000000" />
        </shape>
    </item>
    <!-- 主体 -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/profile_primary" />
        </shape>
    </item>
</layer-list>
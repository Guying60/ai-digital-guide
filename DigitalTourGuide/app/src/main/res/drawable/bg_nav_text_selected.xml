<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中/按压状态：颜色加深（例如半透明黑色遮罩或纯色加深） -->
    <item android:state_selected="true" android:drawable="@color/nav_pressed_bg" />
    <item android:state_pressed="true" android:drawable="@color/nav_pressed_bg" />
    <!-- 默认状态 -->
    <item android:drawable="@android:color/transparent" />
</selector>
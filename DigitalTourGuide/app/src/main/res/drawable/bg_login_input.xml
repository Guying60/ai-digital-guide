<?xml version="1.0" encoding="utf-8"?>
<!--
  Input field background for login page.
  Light surface background, rounded-12dp corners, subtle border, and shadow.
  Matches the HTML input style: bg-surface + rounded-xl + border + custom-shadow-soft.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer (bottom-right glow) -->
    <item
        android:left="0dp"
        android:top="2dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#08000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Background + border -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/login_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/login_outline_variant" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
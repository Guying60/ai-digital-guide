# ===================================================
# docker-compose.yml.example
#
# 使用方式：
#   1. cp docker-compose.yml.example docker-compose.yml
#   2. 将占位符替换为你的真实配置
#   3. docker-compose.yml 已被 .gitignore 忽略
# ===================================================

services:
  mysql-dev:
    image: mysql:latest
    container_name: mysql-dev
    restart: always
    ports:
      - "3306:3306"
    environment:
      MYSQL_ROOT_PASSWORD: <CHANGE_ME>
    command: >
      --innodb-buffer-pool-size=128M
      --innodb-log-buffer-size=8M
      --max-connections=20
      --key-buffer-size=8M
      --sort-buffer-size=512K
      --join-buffer-size=512K
      --read-buffer-size=256K
      --read-rnd-buffer-size=256K
      --performance-schema=OFF
    mem_limit: 450M
    volumes:
      - ./mysql_data:/var/lib/mysql

  redis-dev:
    image: redis/redis-stack:latest
    container_name: redis-dev
    restart: always
    ports:
      - "6379:6379"
      - "8001:8001"
    environment:
      - REDIS_ARGS=--requirepass <CHANGE_ME> --maxmemory 256mb --maxmemory-policy allkeys-lru --appendonly yes
    deploy:
      resources:
        limits:
          memory: 400M
    volumes:
      - ./redis_data:/data

  rabbitmq-dev:
    image: rabbitmq:management
    container_name: rabbitmq-dev
    restart: always
    ports:
      - "5672:5672"
      - "15672:15672"
    environment:
      RABBITMQ_DEFAULT_USER: <CHANGE_ME>
      RABBITMQ_DEFAULT_PASS: <CHANGE_ME>
      RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS: "-rabbit vm_memory_high_watermark 0.15"
    deploy:
      resources:
        limits:
          memory: 400M
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
      - ./plugins/rabbitmq_delayed_message_exchange-4.2.0.ez:/plugins/rabbitmq_delayed_message_exchange-4.2.0.ez
    command: >
      sh -c "rabbitmq-plugins enable rabbitmq_delayed_message_exchange && docker-entrypoint.sh rabbitmq-server"

  markitdown-worker:
    build: ./markitdown-worker
    container_name: markitdown-worker
    restart: unless-stopped
    environment:
      RABBITMQ_HOST: rabbitmq-dev
      RABBITMQ_USER: <CHANGE_ME>
      RABBITMQ_PASS: <CHANGE_ME>
    deploy:
      resources:
        limits:
          memory: 200M
    depends_on:
      - rabbitmq-dev

volumes:
  rabbitmq_data:
